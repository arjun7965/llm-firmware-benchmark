{
  "schemaVersion": "1.3",
  "source": "reference/fault_crash_record.c",
  "mutations": [
    {
      "id": "accept-corrupt-retained-record",
      "description": "Trust a retained record without verifying its checksum.",
      "find": "return record->magic == FAULT_RECORD_MAGIC &&\n    record->checksum == record_checksum(record);",
      "replace": "return record->magic == FAULT_RECORD_MAGIC;"
    },
    {
