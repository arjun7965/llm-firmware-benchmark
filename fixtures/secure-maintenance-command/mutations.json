    { "id": "omit-update-lock-on-challenge", "description": "Leave the update gate and prior authorization active when issuing a debug challenge.", "find": "sec0_write_update_gate(maintenance->security, SEC0_DEBUG_GATE_LOCKED);\n  sec0_revoke_update_authorization(maintenance->security);\n  maintenance->update_authorized = false;", "replace": "(void)maintenance;" },
