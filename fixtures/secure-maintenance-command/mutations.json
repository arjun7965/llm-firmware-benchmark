    { "id": "commit-update-before-authentication", "description": "Commit the update replay sequence before immutable verification succeeds.", "find": "if (!sec0_verify_update_authorization(", "replace": "if (maintenance->update_sequence = sequence, !sec0_verify_update_authorization(" },
