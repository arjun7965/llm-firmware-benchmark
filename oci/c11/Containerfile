FROM docker.io/library/gcc@sha256:82549aa8f90ada3236a8be70c74543132a76662ef33f0c3271ed802b81584a82

ARG SOURCE_REVISION

LABEL org.opencontainers.image.source="https://github.com/arjun7965/llm-firmware-benchmark"
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
LABEL org.opencontainers.image.title="LLM firmware benchmark C11 validator"
LABEL org.opencontainers.image.description="Digest-pinned GCC 14.2.0 validation environment"
LABEL org.opencontainers.image.licenses="Apache-2.0"

RUN printf '%s\n' 'validator:x:65532:' >> /etc/group && printf '%s\n' 'validator:x:65532:65532:OCI validator:/nonexistent:/usr/sbin/nologin' >> /etc/passwd

USER 65532:65532
WORKDIR /workspace
